{
  "name": "react-page-builder-free",
  "version": "2.0.1",
  "description": "Free React page builder — drag-and-drop visual editor built on Gutenberg blocks, with an SSR-safe renderer for Next.js, Remix, and Vite. Open-source, no-code page builder for React apps via onSave/onLoad hooks.",
  "private": false,
  "homepage": "https://react-block-builder.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhavik-dreamz/react-page-builder-free.git"
  },
  "bugs": {
    "url": "https://github.com/bhavik-dreamz/react-page-builder-free/issues"
  },
  "keywords": [
    "react-page-builder",
    "page-builder",
    "page-builder-react",
    "free-page-builder",
    "drag-and-drop",
    "drag-and-drop-builder",
    "visual-editor",
    "website-builder",
    "product-page-builder",
    "seo-friendly",
    "landing-page-seo",
    "demo-pyeage-builder",
    "block-editor",
    "gutenberg",
    "gutenberg-react",
    "wysiwyg",
    "wysiwyg-editor",
    "no-code",
    "content-editor",
    "landing-page-builder",
    "react",
    "nextjs",
    "remix",
    "vite",
    "ssr",
    "cms",
    "headless-cms"
  ],
  "author": {
    "name": "Bhavik Patel",
    "url": "https://github.com/bhavik-dreamz"
  },
  "license": "MIT",
  "main": "./dist/editor.cjs",
  "module": "./dist/editor.mjs",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/editor.mjs",
      "require": "./dist/editor.cjs"
    },
    "./editor": {
      "import": "./dist/editor.mjs",
      "require": "./dist/editor.cjs"
    },
    "./editor-client": {
      "import": "./dist/editor-client.mjs",
      "require": "./dist/editor-client.cjs"
    },
    "./renderer": {
      "import": "./dist/renderer.mjs",
      "require": "./dist/renderer.cjs"
    },
    "./bootstrap": {
      "import": "./dist/bootstrap.mjs",
      "require": "./dist/bootstrap.cjs"
    },
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./vite": {
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./actions": {
      "import": "./dist/actions.mjs",
      "require": "./dist/actions.cjs"
    },
    "./wp": {
      "import": "./dist/wp.mjs",
      "require": "./dist/wp.cjs"
    },
    "./wp/blocks": {
      "import": "./dist/wp/blocks.mjs",
      "require": "./dist/wp/blocks.cjs"
    },
    "./wp/block-editor": {
      "import": "./dist/wp/block-editor.mjs",
      "require": "./dist/wp/block-editor.cjs"
    },
    "./wp/components": {
      "import": "./dist/wp/components.mjs",
      "require": "./dist/wp/components.cjs"
    },
    "./wp/element": {
      "import": "./dist/wp/element.mjs",
      "require": "./dist/wp/element.cjs"
    },
    "./wp/data": {
      "import": "./dist/wp/data.mjs",
      "require": "./dist/wp/data.cjs"
    },
    "./wp/icons": {
      "import": "./dist/wp/icons.mjs",
      "require": "./dist/wp/icons.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./src/registerBlocks.jsx",
    "./src/blocks/**/*.jsx",
    "./dist/styles.css",
    "./dist/bootstrap.mjs",
    "./dist/bootstrap.cjs",
    "./dist/editor.mjs",
    "./dist/editor.cjs"
  ],
  "dependencies": {
    "@wordpress/block-editor": "^15.17.0",
    "@wordpress/block-library": "^9.44.0",
    "@wordpress/blocks": "^15.17.0",
    "@wordpress/components": "^32.6.0",
    "@wordpress/compose": "^7.44.0",
    "@wordpress/data": "^10.44.0",
    "@wordpress/dataviews": "^14.1.0",
    "@wordpress/element": "^6.44.0",
    "@wordpress/format-library": "^5.44.0",
    "@wordpress/hooks": "^4.44.0",
    "@wordpress/global-styles-engine": "^1.11.0",
    "@wordpress/icons": "^12.2.0",
    "@wordpress/keyboard-shortcuts": "^5.44.0",
    "@wordpress/rich-text": "^7.44.0",
    "parsel-js": "^1.2.2",
    "path-browserify": "^1.0.1",
    "postcss-prefix-selector": "^2.1.1",
    "react-icons": "^5.6.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vite": "^8.0.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.js && node scripts/build-styles.mjs",
    "build:lib": "vite build --config vite.lib.config.js && node scripts/build-styles.mjs",
    "build:demo": "pnpm run build:lib && vite build && node scripts/generate-site-assets.mjs && node scripts/fix-meta.mjs && node scripts/prerender-from-live.mjs",
    "preview": "vite preview",
    "preview:demo": "pnpm run build:demo && vite preview --config vite.config.js",
    "test:exports": "pnpm run build:lib && node examples/smoke-exports.mjs",
    "test:ssr": "pnpm run build:lib && node examples/smoke-ssr.mjs && node examples/smoke-renderer-ssr.mjs",
    "test:bundle": "pnpm run build:lib && node examples/verify-renderer-bundle.mjs",
    "test:boundary": "pnpm run build:lib && node examples/verify-package-boundary.mjs",
    "test:react-binding": "pnpm run build:lib && node examples/verify-react-binding.mjs",
    "test:wp-singleton": "pnpm run build:lib && node examples/verify-wp-singleton.mjs",
    "prepublishOnly": "pnpm run test:exports && pnpm run test:bundle && pnpm run test:boundary && pnpm run test:wp-singleton && node examples/verify-react-binding.mjs",
    "publish:shim": "cd shim/gutenberg-block-kit && npm publish --access public",
    "deprecate:shim": "npm deprecate gutenberg-block-kit \"Renamed to react-page-builder-free — run: npm i react-page-builder-free (see https://github.com/bhavik-dreamz/react-page-builder-free)\""
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
