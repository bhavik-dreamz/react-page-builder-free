{
  "name": "gutenberg-block-kit",
  "version": "1.2.1",
  "description": "DEPRECATED — renamed to react-page-builder-free. This version only re-exports react-page-builder-free.",
  "private": false,
  "homepage": "https://www.npmjs.com/package/react-page-builder-free",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhavik-dreamz/react-page-builder-free.git"
  },
  "bugs": {
    "url": "https://github.com/bhavik-dreamz/react-page-builder-free/issues"
  },
  "keywords": [
    "deprecated",
    "react-page-builder-free"
  ],
  "author": {
    "name": "Bhavik Patel",
    "url": "https://github.com/bhavik-dreamz"
  },
  "license": "MIT",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "files": [
    "*.mjs",
    "*.cjs",
    "styles.css",
    "wp",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./editor": {
      "import": "./editor.mjs",
      "require": "./editor.cjs"
    },
    "./editor-client": {
      "import": "./editor-client.mjs",
      "require": "./editor-client.cjs"
    },
    "./renderer": {
      "import": "./renderer.mjs",
      "require": "./renderer.cjs"
    },
    "./bootstrap": {
      "import": "./bootstrap.mjs",
      "require": "./bootstrap.cjs"
    },
    "./styles": "./styles.css",
    "./styles.css": "./styles.css",
    "./vite": {
      "import": "./vite.mjs",
      "require": "./vite.cjs"
    },
    "./actions": {
      "import": "./actions.mjs",
      "require": "./actions.cjs"
    },
    "./wp": {
      "import": "./wp.mjs",
      "require": "./wp.cjs"
    },
    "./wp/blocks": {
      "import": "./wp/blocks.mjs",
      "require": "./wp/blocks.cjs"
    },
    "./wp/block-editor": {
      "import": "./wp/block-editor.mjs",
      "require": "./wp/block-editor.cjs"
    },
    "./wp/components": {
      "import": "./wp/components.mjs",
      "require": "./wp/components.cjs"
    },
    "./wp/element": {
      "import": "./wp/element.mjs",
      "require": "./wp/element.cjs"
    },
    "./wp/data": {
      "import": "./wp/data.mjs",
      "require": "./wp/data.cjs"
    },
    "./wp/icons": {
      "import": "./wp/icons.mjs",
      "require": "./wp/icons.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./bootstrap.mjs",
    "./bootstrap.cjs",
    "./editor.mjs",
    "./editor.cjs"
  ],
  "dependencies": {
    "react-page-builder-free": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
